  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "gen:countries": "bun scripts/build-countries.ts",
    "setup": "bun scripts/setup.ts",
    "sign-in-token": "bun scripts/sign-in-token.ts",
    "db:migrate": "bun --conditions=react-server --env-file=.env.local scripts/migrate.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint --type-aware --deny-warnings",
    "format": "oxfmt .",
    "fallow": "fallow",
    "react-doctor": "react-doctor",
    "typecheck": "next typegen && tsc --noEmit",
    "check:docs": "bun scripts/check-docs.ts",
    "check:bundle": "bun scripts/check-bundle.ts",
    "check:gates": "bun scripts/check-gates.ts",
    "test": "bun test",
    "test:rules": "node --import ./tools/oxlint/node-test-setup.ts --test 'tools/oxlint/**/*.test.ts'",
    "check": "bun run check:gates && bun run format --check && bun run lint && bun run typecheck && bun run check:docs && bun run test && bun run test:rules && NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDA= NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsuZXhhbXBsZS5jb20k NEXT_PUBLIC_MAPBOX_TOKEN=pk.check-bundle TURSO_DATABASE_URL=libsql://ci-placeholder.turso.io TURSO_AUTH_TOKEN=ci bun run build && bun run check:bundle"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.14",
    "@libsql/client": "^0.17.4",
    "@tanstack/react-virtual": "^3.14.9",
    "client-only": "0.0.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "mapbox-gl": "^3.28.1",
    "next": "16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.75.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "1.3.14",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "fallow": "^3.33.1",
    "oxfmt": "0.63.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "7.0.2004",
    "react-doctor": "^0.9.18",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "world-countries": "^5.1.0"
  },
  "devEngines": {
