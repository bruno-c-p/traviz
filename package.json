{
  "name": "traviz",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css",
    "./src/features/app-shell/app-entry.ts",
    "./src/features/landing/landing-entry.ts"
  ],
  "scripts": {
    "gen:countries": "bun scripts/build-countries.ts",
    "setup": "bun scripts/setup.ts",
    "sign-in-token": "bun scripts/sign-in-token.ts",
    "perf": "bun scripts/perf/measure.ts",
    "verify:server": "bun scripts/verify/server.ts",
    "verify:doctor": "bun scripts/verify/doctor.ts",
    "verify:shots": "bun scripts/verify/shots.ts",
    "verify:pixel-diff": "bun scripts/verify/pixel-diff.ts",
    "verify:mark-from-list": "bun scripts/verify/mark-from-list.ts",
    "verify:globe-search": "bun scripts/verify/globe-search.ts",
    "db:migrate": "bun --conditions=react-server --env-file=.env.local scripts/migrate.ts",
    "dev": "astro dev",
    "build": "astro build",
    "build:node": "TRAVIZ_ADAPTER=node astro build",
    "start": "node dist/server/entry.mjs",
    "lint": "oxlint --type-aware --deny-warnings",
    "format": "oxfmt .",
    "fallow": "fallow",
    "typecheck": "astro sync && astro check --minimumFailingSeverity warning && tsc --noEmit && tsc --noEmit -p tsconfig.pure.json",
    "check:docs": "bun scripts/check-docs.ts",
    "check:bundle": "bun scripts/check-bundle.ts",
    "check:gates": "bun scripts/check-gates.ts",
    "test": "bun test",
    "test:rules": "node --import ./tools/oxlint/node-test-setup.ts --test 'tools/oxlint/**/*.test.ts'",
    "check": "bun run check:gates && bun run format --check && bun run lint && bun run typecheck && bun run check:docs && bun run gen:countries --check && bun run test && bun run test:rules && PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsuZXhhbXBsZS5jb20k TURSO_DATABASE_URL=libsql://ci-placeholder.turso.io TURSO_AUTH_TOKEN=ci bun run build && PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsuZXhhbXBsZS5jb20k TURSO_DATABASE_URL=libsql://ci-placeholder.turso.io TURSO_AUTH_TOKEN=ci bun run build:node && bun run check:bundle --production-static .vercel/output/static"
  },
  "dependencies": {
    "@astrojs/node": "11.1.14",
    "@astrojs/vercel": "^11.0.22",
    "@clerk/backend": "^3.32.0",
    "@clerk/shared": "^4.40.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@libsql/client": "^0.17.4",
    "d3-geo": "^3.1.1",
    "server-only": "0.0.1",
    "topojson-client": "^3.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@oxlint/plugins": "1.75.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "1.3.14",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.13.3",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-server": "^3.0.4",
    "@types/topojson-simplify": "^3.0.3",
    "@types/topojson-specification": "^1.0.5",
    "astro": "^7.4.13",
    "fallow": "^3.33.1",
    "oxfmt": "0.63.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "7.0.2004",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.8",
    "world-atlas": "^2.0.2",
    "world-countries": "^5.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.3",
      "onFail": "download"
    }
  }
}
