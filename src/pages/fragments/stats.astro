---
import { loadUserMarks } from "@/features/marks/server";
import StatsView from "@/features/stats/stats-view.astro";

export const partial = true;

const marks = loadUserMarks(Astro.locals.userId);

Astro.response.headers.set("cache-control", "no-store");
---

<StatsView marks={marks} isActive={false} />
