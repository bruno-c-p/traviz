---
type Props = { size: number; class?: string };

const { size, class: className } = Astro.props;
---

<svg
  aria-label="Traviz"
  class={className}
  fill="none"
  height={size}
  role="img"
  viewBox="0 0 48 48"
  width={size}
  xmlns="http://www.w3.org/2000/svg"
>
  <rect fill="currentColor" height="48" rx="14" width="48"></rect>
  <path
    d="M13 15H35M24 15V34"
    stroke="var(--color-on-primary, #0e0f0c)"
    stroke-linecap="round"
    stroke-width="6"></path>
  <circle cx="13" cy="15" fill="var(--color-on-primary, #0e0f0c)" r="3"></circle>
  <path
    d="M24 34L19.5 29.5M24 34L28.5 29.5"
    stroke="var(--color-on-primary, #0e0f0c)"
    stroke-linecap="round"
    stroke-width="4"></path>
</svg>
