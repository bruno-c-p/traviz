---
import { THEME_CHOICES, THEME_LABELS } from "@/features/theme/theme";
import type { ThemeChoice } from "@/features/theme/theme";
import type { InlineIconName } from "@/shared/icons/icons";
import InlineIcon from "@/shared/icons/inline-icon.astro";

const THEME_ICONS: Record<ThemeChoice, InlineIconName> = {
  system: "desktop",
  light: "sun",
  dark: "moon",
};
---

<div
  data-theme-picker
  role="radiogroup"
  aria-label="Theme"
  class="grid grid-cols-3 gap-1 rounded-full bg-canvas-soft p-1"
>
  {
    THEME_CHOICES.map((option) => (
      <label class="pressable flex min-h-11 cursor-pointer items-center justify-center gap-2 rounded-full px-3 text-sm font-semibold text-body hover:text-ink has-checked:bg-canvas has-checked:text-ink has-checked:shadow-card has-focus-visible:ring-2 has-focus-visible:ring-ink">
        <input type="radio" name="theme" value={option} class="sr-only" />
        <InlineIcon name={THEME_ICONS[option]} class="size-4" />
        {THEME_LABELS[option]}
      </label>
    ))
  }
</div>
