---
import NavLinks from "@/features/app-shell/nav-links.astro";
import type { ViewName } from "@/features/app-shell/navigation";

type Props = { view: ViewName };

const { view } = Astro.props;
---

<nav
  aria-label="Main"
  class="fixed inset-x-4 z-40 grid grid-cols-3 gap-1 rounded-3xl bg-canvas p-1.5 shadow-float md:hidden"
  style="bottom:max(1rem, env(safe-area-inset-bottom))"
>
  <NavLinks view={view} placement="tab" />
</nav>
