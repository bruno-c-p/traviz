---
import "@fontsource-variable/geist-mono/wght.css";
import "@fontsource-variable/instrument-sans/wght.css";
import "@/features/app-shell/app.css";
import type { ViewName } from "@/features/app-shell/navigation";
import TabBar from "@/features/app-shell/tab-bar.astro";
import TopBar from "@/features/app-shell/top-bar.astro";
import { EARLY_TAPS_SCRIPT } from "@/features/marks/core";
import MarksSnapshotScript from "@/features/marks/marks-snapshot.astro";
import type { MarksSnapshot } from "@/features/marks";
import { THEME_SCRIPT } from "@/features/theme/core";
import PageHead from "@/shared/page-head.astro";
import appScript from "virtual:traviz-app-script";

type Props = { view: ViewName; marks: Promise<MarksSnapshot | null> };

const { view, marks } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <PageHead title="traviz" />
    <script is:inline set:html={THEME_SCRIPT} />
    <script is:inline set:html={EARLY_TAPS_SCRIPT} />
  </head>
  <body class="bg-canvas-soft font-sans text-ink">
    <TopBar view={view} />
    <TabBar view={view} />
    <div class="fixed inset-0 overflow-hidden bg-canvas-soft">
      <div data-globe-slot class="absolute inset-0"><slot name="globe" /></div>
      <div
        data-panel-scroll
        class:list={[
          "absolute inset-0 z-10 overflow-y-auto bg-canvas-soft pb-32 md:top-[76px] md:pb-12",
          view === "globe" && "invisible pointer-events-none",
        ]}
      >
        <slot />
      </div>
    </div>
    <MarksSnapshotScript marks={marks} />
    <script is:inline type="module" set:html={appScript} />
  </body>
</html>
