---
import { SIGN_OUT_LABEL } from "@/features/auth/account-section";
import DangerZone from "@/features/marks/danger-zone.astro";
import ThemePicker from "@/features/theme/theme-picker.astro";
import Icon from "@/shared/icons/icon.astro";
import InlineIcon from "@/shared/icons/inline-icon.astro";
---

<dialog
  data-account-menu
  aria-labelledby="account-menu-heading"
  class="fixed inset-x-0 top-auto bottom-0 m-0 max-h-[calc(100dvh-3rem)] w-full max-w-none overflow-y-auto rounded-t-[28px] border-0 bg-canvas p-0 text-ink shadow-card transition-[opacity,translate] duration-200 ease-out backdrop:bg-black/40 starting:opacity-0 motion-safe:starting:translate-y-3 md:inset-x-auto md:top-[76px] md:right-6 md:bottom-auto md:max-h-[calc(100dvh-100px)] md:w-[380px] md:rounded-3xl md:motion-safe:starting:-translate-y-2"
>
  <div
    class="flex flex-col gap-6 px-5 pt-5"
    style="padding-bottom:max(1.25rem, env(safe-area-inset-bottom))"
  >
    <div class="flex items-center justify-between gap-3">
      <h2 id="account-menu-heading" class="text-xl font-bold tracking-tight text-ink">Account</h2>
      <button
        type="button"
        data-account-menu-close
        aria-label="Close"
        class="pressable -mr-1.5 flex size-11 shrink-0 items-center justify-center rounded-full text-body hover:bg-canvas-soft hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink"
      >
        <Icon name="cross-2" size="size-5" />
      </button>
    </div>

    <section aria-label="Signed in as" class="flex flex-col gap-3">
      <div
        class="flex items-center justify-between gap-3 rounded-full bg-canvas-soft py-1.5 pl-4 pr-1.5"
      >
        <span data-account-email class="min-w-0 truncate text-sm font-medium text-ink"></span>
        <button
          type="button"
          data-sign-out
          class="pressable flex min-h-11 shrink-0 items-center gap-2 rounded-full bg-canvas px-4 text-sm font-semibold text-ink hover:bg-land focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink disabled:cursor-not-allowed disabled:opacity-60"
        >
          <InlineIcon name="exit" class="size-4" />
          <span data-sign-out-label>{SIGN_OUT_LABEL}</span>
        </button>
      </div>
      <p class="text-sm leading-relaxed text-body">
        Your marks sync to this account. Sign in on any device to pick up where you left off.
      </p>
      <p data-sign-out-failed role="alert" hidden class="text-sm text-negative-text">
        Couldn't sign out. Check your connection and try again.
      </p>
    </section>
    <div data-snapshot-status class="-mt-3 empty:hidden"></div>

    <section class="flex flex-col gap-3">
      <h3 class="font-mono text-xs uppercase tracking-wider text-mute">Theme</h3>
      <ThemePicker />
    </section>

    <DangerZone class="border-t border-line pt-5" />
  </div>
</dialog>
