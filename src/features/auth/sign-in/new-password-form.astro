---
import { MIN_PASSWORD_LENGTH } from "@/features/auth/password-sign-in";
import {
  ERROR_CLASS,
  INPUT_CLASS,
  HINT_CLASS,
  LABEL_CLASS,
  PRIMARY_ACTION_CLASS,
  SUBMIT_LABELS,
  TEXT_ACTION_CLASS,
} from "@/features/auth/sign-in/sign-in-classes";
---

<form data-sign-in-step="new-password" hidden class="flex flex-col gap-3">
  <input type="email" name="email" autocomplete="username" readonly hidden data-account-email />
  <label for="new-password" class={LABEL_CLASS}>New password</label>
  <input
    id="new-password"
    name="new-password"
    type="password"
    autocomplete="new-password"
    minlength={MIN_PASSWORD_LENGTH}
    required
    aria-describedby="new-password-hint"
    data-sign-in-field="password"
    class={INPUT_CLASS}
  />
  <p id="new-password-hint" class={HINT_CLASS}>{MIN_PASSWORD_LENGTH} characters or more.</p>
  <p id="new-password-error" data-sign-in-error role="alert" hidden class={ERROR_CLASS}></p>
  <button type="submit" class={PRIMARY_ACTION_CLASS}>{SUBMIT_LABELS["new-password"]}</button>
  <button type="button" data-restart class:list={["self-center", TEXT_ACTION_CLASS]}>
    Start over
  </button>
</form>
