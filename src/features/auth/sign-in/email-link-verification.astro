---
import { VERIFICATION_MESSAGES } from "@/features/auth/email-link-verification";
import { PRIMARY_ACTION_CLASS } from "@/features/auth/sign-in/sign-in-classes";
import { signInPath } from "@/paths";

const { title, body } = VERIFICATION_MESSAGES.checking;
---

<div class="flex flex-col items-start gap-3">
  <h1 data-verification-title aria-live="polite" class="text-2xl font-bold tracking-tight text-ink">
    {title}
  </h1>
  <p data-verification-body class="text-[15px] leading-relaxed text-body">{body}</p>
  <a
    href={signInPath()}
    data-verification-retry
    hidden
    class:list={["mt-4 flex items-center justify-center", PRIMARY_ACTION_CLASS]}
  >
    Get a new link
  </a>
</div>

<script>
  import { startVerifyPage } from "@/features/auth/verify-page";

  startVerifyPage();
</script>
