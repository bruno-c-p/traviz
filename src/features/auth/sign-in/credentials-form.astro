---
import { MIN_PASSWORD_LENGTH } from "@/features/auth/password-sign-in";
import {
  ERROR_CLASS,
  INPUT_CLASS,
  HINT_CLASS,
  LABEL_CLASS,
  PRIMARY_ACTION_CLASS,
  SUBMIT_LABELS,
  TEXT_ACTION_CLASS,
} from "@/features/auth/sign-in/sign-in-classes";
---

<form data-sign-in-step="credentials" class="flex flex-col gap-3">
  <label for="email" class={LABEL_CLASS}>Email</label>
  <input
    id="email"
    name="email"
    type="email"
    inputmode="email"
    autocomplete="username"
    required
    placeholder="you@example.com"
    data-sign-in-field="email"
    class={INPUT_CLASS}
  />
  <label for="password" class:list={["mt-1", LABEL_CLASS]}>Password</label>
  <input
    id="password"
    name="password"
    type="password"
    autocomplete="current-password"
    required
    data-sign-in-field="password"
    class={INPUT_CLASS}
  />
  <p id="credentials-error" data-sign-in-error role="alert" hidden class={ERROR_CLASS}></p>
  <button type="submit" class={PRIMARY_ACTION_CLASS}>{SUBMIT_LABELS.credentials}</button>
  <button type="button" data-forgot-password class:list={["self-center", TEXT_ACTION_CLASS]}>
    Forgot password?
  </button>
  <p class:list={["text-center", HINT_CLASS]}>
    New here? Enter your email and a password of {MIN_PASSWORD_LENGTH} characters or more to create
    your account.
  </p>
</form>
