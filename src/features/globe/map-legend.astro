---
import { COUNTRY_STATES, STATE_COLORS, STATE_LABELS } from "@/features/marks/core";

type Props = { class?: string };

const { class: className } = Astro.props;
---

<ul aria-label="Legend" class:list={["flex-wrap gap-2", className]}>
  {
    COUNTRY_STATES.map((countryState) => (
      <li class="flex min-h-9 items-center gap-2 rounded-full bg-canvas px-3.5 text-[13px] font-medium text-ink shadow-float">
        <span
          aria-hidden="true"
          class="size-2.5 rounded-full"
          style={`background-color:${STATE_COLORS[countryState]}`}
        />
        {STATE_LABELS[countryState]}
      </li>
    ))
  }
</ul>
