---
import CountryHeading from "@/features/countries/country-heading.astro";
import ClearMarkButton from "@/features/marks/clear-mark-button.astro";
import MarkChoices from "@/features/marks/mark-choices.astro";
import MarkStatus from "@/features/marks/mark-status.astro";

const headingId = "globe-country-card-heading";
---

<section
  data-country-card
  hidden
  aria-labelledby={headingId}
  class="flex flex-col gap-5 rounded-3xl bg-canvas p-5 shadow-card transition-[translate,opacity] duration-200 ease-out starting:opacity-0 motion-safe:starting:translate-y-1"
>
  <CountryHeading headingId={headingId} />
  <MarkChoices layout="tiles" />
  <MarkStatus class="-mt-3 text-xs" />
  <ClearMarkButton class="-my-2 self-start px-1" />
</section>
