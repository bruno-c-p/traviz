{
  "files": {
    ".github/workflows/ci.yml": {
      "name": "CI",
      "on": {
        "push": {
          "branches": ["main"]
        },
        "pull_request": null
      },
      "concurrency": {
        "group": "ci-${{ github.ref }}",
        "cancel-in-progress": true
      },
      "permissions": {
        "contents": "read"
      },
      "jobs": {
        "check": {
          "runs-on": "ubuntu-latest",
          "steps": [
            {
              "uses": "actions/checkout@v7"
            },
            {
              "uses": "oven-sh/setup-bun@v2",
              "with": {
                "bun-version": "1.4.3"
              }
            },
            {
              "uses": "actions/setup-node@v7",
              "with": {
                "node-version": 24
              }
            },
            {
              "id": "install",
              "run": "bun install --frozen-lockfile"
            },
            {
              "run": "bun run check"
            },
            {
              "if": "${{ !cancelled() && steps.install.outcome == 'success' }}",
              "run": "bun run fallow"
            },
            {
              "if": "${{ !cancelled() && steps.install.outcome == 'success' }}",
              "run": "bun run react-doctor --no-telemetry"
            }
          ]
        }
      }
    },
    "tsconfig.json": {
      "compilerOptions": {
        "target": "es2023",
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "module": "esnext",
        "moduleResolution": "bundler",
        "paths": {
          "@/paths": ["./paths.ts"],
          "@/*": ["./src/*"]
        },
        "types": ["node", "geojson", "bun"],
        "allowJs": true,
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "verbatimModuleSyntax": true,
        "moduleDetection": "force",
        "esModuleInterop": true,
        "isolatedModules": true,
        "skipLibCheck": true,
        "noEmit": true,
        "incremental": true,
        "jsx": "react-jsx",
        "forceConsistentCasingInFileNames": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "erasableSyntaxOnly": true,
        "noFallthroughCasesInSwitch": true,
        "plugins": [
          {
            "name": "next"
          }
        ],
        "strict": true
      },
      "include": [
        "src",
        "scripts",
        "next-env.d.ts",
        ".next/types/**/*.ts",
        ".next/dev/types/**/*.ts"
      ],
      "exclude": ["node_modules"]
    },
    ".oxlintrc.json": {
      "$schema": "./node_modules/oxlint/configuration_schema.json",
      "plugins": ["react", "typescript", "oxc"],
      "categories": {
        "correctness": "error"
      },
      "rules": {
        "react/rules-of-hooks": "error",
        "react/only-export-components": [
          "error",
          {
            "allowConstantExport": true,
            "allowExportNames": ["metadata", "viewport"]
          }
        ],
        "oxc/no-accumulating-spread": "error",
        "typescript/no-explicit-any": "error",
        "typescript/consistent-type-assertions": [
          "error",
          {
            "assertionStyle": "never"
          }
        ],
        "typescript/use-unknown-in-catch-callback-variable": "error",
        "typescript/no-unsafe-argument": "error",
        "typescript/no-unsafe-assignment": "error",
        "typescript/no-unsafe-return": "error",
        "typescript/no-unsafe-member-access": "error",
        "typescript/no-unsafe-call": "error",
        "typescript/no-non-null-assertion": "error",
        "typescript/ban-ts-comment": [
          "error",
          {
            "ts-expect-error": true
          }
        ],
        "anti-slop/no-array-filter-map": "error",
        "anti-slop/no-reduce-accumulator-copy": "error",
        "anti-slop/no-chained-type-assertions": "error",
        "anti-slop/no-conditional-empty-object-spread": "error",
        "anti-slop/no-known-value-widening": "error",
        "anti-slop/no-module-mocking": "error",
        "anti-slop/no-object-parameters": "error",
        "anti-slop/no-reflect-apply": "error",
        "anti-slop/no-reflect-get": "error",
        "anti-slop/no-runtime-typeof": "error",
        "anti-slop/no-shape-in-symbol-names": "error",
        "anti-slop/no-unknown-parameters": "error",
        "anti-slop/no-unknown-returns": "error",
        "anti-slop/no-unknown-type-aliases": "error",
        "anti-slop/no-unsafe-dictionary-type": "error",
        "anti-slop/no-widen-then-assert": "error",
        "anti-slop/require-readable-spacing": "error",
        "no-restricted-globals": [
          "error",
          {
            "name": "Bun",
            "message": "The app runs on Node in production. Use Bun APIs only in tests, src/testing and scripts."
          }
        ],
        "no-restricted-properties": [
          "error",
          {
            "object": "globalThis",
            "property": "Bun",
            "message": "The app runs on Node in production. Use Bun APIs only in tests, src/testing and scripts."
          }
        ]
      },
      "overrides": [
        {
          "files": ["src/components/virtual-country-list.tsx"],
          "rules": {
            "react/incompatible-library": "off"
          }
        },
        {
          "files": ["./paths.ts"],
          "rules": {
            "typescript/consistent-type-assertions": "off"
          }
        },
        {
          "files": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/testing/**", "scripts/**"],
          "rules": {
            "no-restricted-globals": "off",
            "no-restricted-properties": "off"
          }
        }
      ],
      "ignorePatterns": ["tools/oxlint/anti-slop/**"],
      "jsPlugins": [
        {
          "name": "anti-slop",
          "specifier": "./tools/oxlint/anti-slop/index.ts"
        }
      ]
    },
    ".fallowrc.json": {
      "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
      "ignorePatterns": ["tools/**"],
      "ignoreDependencies": ["@oxlint/plugins"],
      "health": {
        "maxCrap": 73
      }
    },
    "doctor.config.json": {
      "adoptExistingLintConfig": false,
      "blocking": "warning",
      "ignore": {
        "files": ["tools/**"]
      }
    }
  },
  "scripts": {
    "lint": "oxlint --type-aware --deny-warnings",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:rules": "node --import ./tools/oxlint/node-test-setup.ts --test 'tools/oxlint/**/*.test.ts'",
    "format": "oxfmt .",
    "build": "next build",
    "fallow": "fallow",
    "react-doctor": "react-doctor",
    "check:gates": "bun scripts/check-gates.ts",
    "check:docs": "bun scripts/check-docs.ts",
    "check:bundle": "bun scripts/check-bundle.ts",
    "check": "bun run check:gates && bun run format --check && bun run lint && bun run typecheck && bun run check:docs && bun run test && bun run test:rules && NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDA= NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsuZXhhbXBsZS5jb20k NEXT_PUBLIC_MAPBOX_TOKEN=pk.check-bundle TURSO_DATABASE_URL=libsql://ci-placeholder.turso.io TURSO_AUTH_TOKEN=ci bun run build && bun run check:bundle"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.3",
      "onFail": "download"
    }
  }
}
