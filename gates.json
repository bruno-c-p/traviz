{
  "files": {
    ".github/workflows/ci.yml": {
      "name": "CI",
      "on": {
        "push": {
          "branches": ["main"]
        },
        "pull_request": null
      },
      "concurrency": {
        "group": "ci-${{ github.ref }}",
        "cancel-in-progress": true
      },
      "permissions": {
        "contents": "read"
      },
      "jobs": {
        "check": {
          "runs-on": "ubuntu-latest",
          "steps": [
            {
              "uses": "actions/checkout@v7"
            },
            {
              "uses": "oven-sh/setup-bun@v2",
              "with": {
                "bun-version": "1.4.3"
              }
            },
            {
              "uses": "actions/setup-node@v7",
              "with": {
                "node-version": 24
              }
            },
            {
              "id": "install",
              "run": "bun install --frozen-lockfile"
            },
            {
              "run": "bun run check"
            },
            {
              "if": "${{ !cancelled() && steps.install.outcome == 'success' }}",
              "run": "bun run fallow"
            }
          ]
        }
      }
    },
    "tsconfig.json": {
      "compilerOptions": {
        "target": "es2023",
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "module": "esnext",
        "moduleResolution": "bundler",
        "paths": {
          "@/paths": ["./paths.ts"],
          "@/*": ["./src/*"]
        },
        "types": ["node", "geojson", "bun"],
        "allowJs": true,
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "verbatimModuleSyntax": true,
        "moduleDetection": "force",
        "esModuleInterop": true,
        "isolatedModules": true,
        "skipLibCheck": true,
        "noEmit": true,
        "incremental": true,
        "forceConsistentCasingInFileNames": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "erasableSyntaxOnly": true,
        "noFallthroughCasesInSwitch": true,
        "strict": true
      },
      "include": ["src", "scripts", "astro.config.ts", "paths.ts", ".astro/types.d.ts"],
      "exclude": ["node_modules", "dist", "legacy-react"]
    },
    ".oxlintrc.json": {
      "$schema": "./node_modules/oxlint/configuration_schema.json",
      "plugins": ["typescript", "oxc", "unicorn", "import"],
      "categories": {
        "correctness": "error"
      },
      "rules": {
        "oxc/no-accumulating-spread": "error",
        "unicorn/filename-case": [
          "error",
          {
            "case": "kebabCase"
          }
        ],
        "import/no-relative-parent-imports": "error",
        "import/no-unassigned-import": [
          "error",
          {
            "allow": ["**/*.css", "server-only", "client-only"]
          }
        ],
        "typescript/no-explicit-any": "error",
        "typescript/consistent-type-assertions": [
          "error",
          {
            "assertionStyle": "never"
          }
        ],
        "typescript/use-unknown-in-catch-callback-variable": "error",
        "typescript/no-unsafe-argument": "error",
        "typescript/no-unsafe-assignment": "error",
        "typescript/no-unsafe-return": "error",
        "typescript/no-unsafe-member-access": "error",
        "typescript/no-unsafe-call": "error",
        "typescript/no-non-null-assertion": "error",
        "typescript/ban-ts-comment": [
          "error",
          {
            "ts-expect-error": true
          }
        ],
        "anti-slop/no-array-filter-map": "error",
        "anti-slop/no-reduce-accumulator-copy": "error",
        "anti-slop/no-chained-type-assertions": "error",
        "anti-slop/no-conditional-empty-object-spread": "error",
        "anti-slop/no-known-value-widening": "error",
        "anti-slop/no-module-mocking": "error",
        "anti-slop/no-object-parameters": "error",
        "anti-slop/no-reflect-apply": "error",
        "anti-slop/no-reflect-get": "error",
        "anti-slop/no-runtime-typeof": "error",
        "anti-slop/no-shape-in-symbol-names": "error",
        "anti-slop/no-unknown-parameters": "error",
        "anti-slop/no-unknown-returns": "error",
        "anti-slop/no-unknown-type-aliases": "error",
        "anti-slop/no-unsafe-dictionary-type": "error",
        "anti-slop/no-widen-then-assert": "error",
        "anti-slop/require-readable-spacing": "error",
        "boundaries/api-route": "error",
        "boundaries/feature-entry": "error",
        "boundaries/no-comments": "error",
        "boundaries/no-empty-import": "error",
        "boundaries/server-only-module": "error",
        "no-restricted-globals": [
          "error",
          {
            "name": "Bun",
            "message": "The app runs on Node in production. Use Bun APIs only in tests, src/shared/testing and scripts."
          }
        ],
        "no-restricted-properties": [
          "error",
          {
            "object": "globalThis",
            "property": "Bun",
            "message": "The app runs on Node in production. Use Bun APIs only in tests, src/shared/testing and scripts."
          }
        ]
      },
      "overrides": [
        {
          "files": ["./paths.ts"],
          "rules": {
            "typescript/consistent-type-assertions": "off"
          }
        },
        {
          "files": ["src/**/*.test.ts", "src/shared/testing/**", "scripts/**"],
          "rules": {
            "no-restricted-globals": "off",
            "no-restricted-properties": "off"
          }
        }
      ],
      "ignorePatterns": ["tools/oxlint/anti-slop/**", "legacy-react/**"],
      "jsPlugins": [
        {
          "name": "anti-slop",
          "specifier": "./tools/oxlint/anti-slop/index.ts"
        },
        {
          "name": "boundaries",
          "specifier": "./tools/oxlint/boundaries/index.ts"
        }
      ]
    },
    ".fallowrc.json": {
      "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
      "entry": ["src/features/*/*-entry.ts"],
      "ignorePatterns": ["tools/**", "legacy-react/**"],
      "ignoreDependencies": ["@oxlint/plugins"],
      "ignoreExports": [
        {
          "file": "paths.ts",
          "exports": ["decoratedPath"]
        },
        {
          "file": "src/features/auth/index.ts",
          "exports": ["clerkSession"]
        },
        {
          "file": "src/features/auth/server.ts",
          "exports": ["Authenticate", "RequestAuth"]
        },
        {
          "file": "src/features/globe/mount-globe.ts",
          "exports": ["mountGlobe"]
        },
        {
          "file": "src/features/globe/sheet-exit.ts",
          "exports": ["EXIT_MS"]
        },
        {
          "file": "src/features/globe/create-globe.ts",
          "exports": ["Globe"]
        },
        {
          "file": "src/features/marks/colors.ts",
          "exports": ["STATE_ON_COLORS", "STATE_HINTS"]
        },
        {
          "file": "src/features/marks/index.ts",
          "exports": ["STATE_ON_COLORS", "endMarksSession", "SavingScopes", "SyncProblem"]
        },
        {
          "file": "src/features/theme/index.ts",
          "exports": [
            "THEME_CHOICES",
            "THEME_LABELS",
            "chooseTheme",
            "subscribeTheme",
            "themeChoice",
            "ThemeChoice"
          ]
        },
        {
          "file": "src/features/theme/theme-store.ts",
          "exports": ["themeChoice", "chooseTheme"]
        },
        {
          "file": "src/features/theme/theme.ts",
          "exports": ["THEME_CHOICES", "THEME_LABELS"]
        }
      ],
      "health": {
        "maxCrap": 73
      }
    },
    ".oxfmtrc.json": {
      "ignorePatterns": ["tools/oxlint/anti-slop/**"]
    },
    "bunfig.toml": {
      "test": {
        "root": "src",
        "preload": ["./src/shared/testing/server-only-preload.ts"]
      }
    },
    "tsconfig.pure.json": {
      "extends": "./tsconfig.json",
      "compilerOptions": {
        "lib": ["ES2023"],
        "types": [],
        "incremental": false
      },
      "include": [],
      "files": [
        "src/features/marks/marks-sync.ts",
        "src/features/marks/marks-owner.ts",
        "src/features/marks/tally.ts",
        "src/features/globe/globe-camera.ts",
        "src/features/globe/globe-gestures.ts",
        "src/features/globe/globe-keys.ts",
        "src/features/globe/globe-labels.ts"
      ]
    }
  },
  "scripts": {
    "lint": "oxlint --type-aware --deny-warnings",
    "typecheck": "astro sync && astro check --minimumFailingSeverity warning && tsc --noEmit && tsc --noEmit -p tsconfig.pure.json",
    "test": "bun test",
    "test:rules": "node --import ./tools/oxlint/node-test-setup.ts --test 'tools/oxlint/**/*.test.ts'",
    "format": "oxfmt .",
    "build": "astro build",
    "build:node": "TRAVIZ_ADAPTER=node astro build",
    "fallow": "fallow",
    "check:gates": "bun scripts/check-gates.ts",
    "check:docs": "bun scripts/check-docs.ts",
    "check:bundle": "bun scripts/check-bundle.ts",
    "check": "bun run check:gates && bun run format --check && bun run lint && bun run typecheck && bun run check:docs && bun run gen:countries --check && bun run test && bun run test:rules && PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsuZXhhbXBsZS5jb20k TURSO_DATABASE_URL=libsql://ci-placeholder.turso.io TURSO_AUTH_TOKEN=ci bun run build && PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsuZXhhbXBsZS5jb20k TURSO_DATABASE_URL=libsql://ci-placeholder.turso.io TURSO_AUTH_TOKEN=ci bun run build:node && bun run check:bundle --production-static .vercel/output/static"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.3",
      "onFail": "download"
    }
  },
  "bundleBudget": {
    "tolerance": {
      "percent": 1,
      "minBytes": 1024
    },
    "routes": {
      "/": {
        "firstLoadGzipBytes": 9583,
        "lazyGzipBytes": 0,
        "htmlGzipBytes": 20334
      },
      "/list": {
